# Android fstab file.
# <src>        <mnt_point>    <type>    <mnt_flags_and_options>    <fs_mgr_flags>
/dev/block/sda1   /system        ext4      ro,barrier=1                wait
/dev/block/sda2   /vendor        ext4      ro,barrier=1                wait
/dev/block/sda3   /data          ext4      noatime,nosuid,nodev        wait
